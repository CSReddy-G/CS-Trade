*.pid
STOP
status.json
scalp_status.json
positions.json
state.json
agents.json

# Logs
*.log

# Generated trade logs and backtest output (rewritten on every run)
trades.csv
backtest_trades.csv
scalp_backtest_trades.csv
scalp_rejections.csv

# Local backups
backups/

# Secret key for opening the control panel from your phone
phone_key.txt

# Panel users: password hashes plus each user's settings, Kite token, trades and logs
users/
deploy/.env

# Local 5-minute candle store for backtests (candle_store.py)
data/candle_store.pkl
